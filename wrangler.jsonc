{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pico2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b3830a07-0696-42f8-b2ec-75a79039c552","database_name": "pico2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "de48db0fca044859b398182a5707f040" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
